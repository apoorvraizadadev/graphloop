  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9494987737f96d7468c0e353597094ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  texts:
  - This is a <color=#EC4B3B>node</color>. Try moving it around with the left mouse
    button. <br>(Press Enter to skip this tutorial)
  - You can add connections between nodes by right-click dragging from one node to
    another.
  - Now, create a loop by adding two more connections.
  - Your score is shown in the top-right corner. You get 5 points for each loop,
    but the longer the loop, the more points you get. <br>(Press Space to continue)
  - There is also a limit on how many connections you can make, shown in the top-left
    corner. Every node must be connected in order to count. <br>(Press Space to continue)
  - Also, you can try deleting connections by middle-mouse clicking on them.
  - Finally, you can pan the camera by dragging anywhere (except for on a node)...
  - ...and zoom the camera with the scroll wheel.
  - Once you're done, you can click the done button.
  dialogueNumber: 0
  textAppearTime: 0.5
  startingNode: {fileID: 1771400977}
  nodePrefab: {fileID: 2617356219645589876, guid: d8e1e0a83b6dfa544b46c33f0c4a03e9, type: 3}
  secondNode: {fileID: 0}
  thirdNode: {fileID: 0}
  score: {fileID: 987395860}
  connectionsLeft: {fileID: 223718550}
  doneButton: {fileID: 1237904571}
